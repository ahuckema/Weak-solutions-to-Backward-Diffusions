\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhead[RO,LE]{%
  \tikz[baseline=(char.base)]{
    \node[shape=rectangle,fill=black,text=white,inner sep=2pt] (char) {\thepage};
  }
}

\fancyhead[RE,LO]{\nouppercase{\leftmark}} 
\renewcommand{\headrulewidth}{4pt} 
\renewcommand{\sectionmark}[1]{\markboth{#1}{}} % Shifted from \chaptermark
\fancyfoot{} 

\fancypagestyle{frontpage}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \vspace*{1\baselineskip}
  
  \fancyhead[R]{École Nationale de Commerce et de Gestion
  \linebreak       Casablanca, 2020\vspace*{.5\baselineskip}}
}

% %---------------  -----------------------------------------------------------
% %     SECTIONS 
% %--------------------------------------------------------------------------
\renewcommand\thesubsubsection{\arabic{subsection}.\roman{subsubsection}}
\renewcommand\thesubsection{\thesection.\arabic{subsection}}
\renewcommand\thesection{\arabic{section}}

\makeatletter
\@addtoreset{section}{part} % Shifted from chapter
\makeatother  

\RequirePackage[titles]{tocloft}
\RequirePackage{titletoc}

% Shifted mini-TOC from chapters to sections
\newcommand{\sectiontoc}{% 
    \startcontents[sections]
    \printcontents[sections]{}{1}{\setcounter{tocdepth}{1}}
    \vspace{0.5cm}
}

\newcommand{\intro}[1]{
\noindent
\begin{minipage}[t]{0.48\textwidth}
    \sectiontoc
\end{minipage}%
\hfill
\begin{minipage}[t]{0.48\textwidth}
    #1
\end{minipage}
\newpage
}

\RequirePackage[explicit]{titlesec}

% Shifted titleformat from \chapter to \section
\titleformat{\section}[display]
{\centering\normalfont\huge}
{\titlerule[5pt]\vspace{3pt}\titlerule[2pt]\vspace{3pt}\textbf{\MakeUppercase{Section} \thesection}}
{0pt}
{\titlerule[2pt]\vspace{1pc}\huge\MakeUppercase{#1}}

\titleformat{name=\section,numberless}[display]
{  \centering\normalfont\huge}
{\titlerule[2pt]\vspace{-20pt}}
{0pt}
{\huge\MakeUppercase{#1} \addcontentsline{toc}{section}{#1} }

